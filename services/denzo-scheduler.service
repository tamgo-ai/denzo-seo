[Unit]
Description=DENZO-SEO Daily scheduler and publication verifier
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/denzo-seo
Environment=DENZO_EXECUTOR=rq
EnvironmentFile=/root/denzo-seo/.env
ExecStart=/root/denzo-seo/.venv/bin/python -m denzo.scheduler
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=denzo-scheduler

[Install]
WantedBy=multi-user.target
